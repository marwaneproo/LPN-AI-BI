POSTGRES_DB=lpn_ai_bi
POSTGRES_APP_ADMIN_PASSWORD=change_me_app_admin
POSTGRES_AI_READONLY_PASSWORD=change_me_ai_readonly
# Required for first-run administrator creation and safe rotation. Use 12+ characters.
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Keep false for local HTTP. Set true behind an HTTPS gateway.
AUTH_COOKIE_SECURE=false
PERFORMANCE_TRACING_ENABLED=true
SQL_EXECUTOR_QUERY_TIMEOUT_SECONDS=30
SQL_EXECUTOR_MAX_ROW_COUNT=10000

SCHEMA_RETRIEVAL_ADMIN_KEY=change_me_schema_admin

# Native Windows Ollama. Containers reach the host Ollama API through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Current native Ollama test setup.
SQL_MODEL=qwen2.5-coder:7b
SQL_REASONING_MODEL=qwen2.5-coder:14b
SQL_FALLBACK_MODEL=qwen2.5-coder:7b
NARRATOR_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=240
SQL_MODEL_TIMEOUT_SECONDS=240
SQL_REASONING_MODEL_TIMEOUT_SECONDS=360
NARRATOR_MODEL_TIMEOUT_SECONDS=150
OLLAMA_KEEP_ALIVE_SECONDS=1800
OLLAMA_NUM_CTX=4096
SQL_MODEL_NUM_PREDICT=256
NARRATOR_MODEL_NUM_PREDICT=512
SQL_MODEL_NUM_GPU=0
NARRATOR_MODEL_NUM_GPU=0
SCHEMA_RETRIEVAL_BASE_URL=http://localhost:8084
