{
  "name": "LPN AI BI - Processus Vente",
  "dataColors": [
    "#0EA5E9",
    "#2563EB",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#8B5CF6",
    "#14B8A6",
    "#64748B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#0EA5E9",
  "visualStyles": {
    "*": {
      "*": {
        "fontFamily": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "transparency": 70,
            "blur": 8,
            "angle": 45,
            "distance": 2
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 11
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "textSize": 10
          }
        ]
      }
    }
  },
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#0F172A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#475569"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#0F172A"
    }
  }
}
